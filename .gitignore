.vscode/
.vs/
*.user
*.suo
*.swp
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
# The SDK's XenAPI module, if copied in rather than installed from PyPI
python/XenAPI.py

# C#
csharp/bin/
csharp/obj/

# Go: the binary `go build` makes, and the SDK's Go binding copied in (see go/README.md)
go/workflows
go/workflows.exe
go/goSDK/

# Java
java/target/

# PowerShell: an SDK module or package copied in by mistake
powershell/**/*.dll
powershell/**/*.zip

# xe CLI: the files the examples write in cli/ while they run (they remove them when they finish)
cli/cli-*.bin
cli/cli-*.xva
cli/cli-*.backup
cli/cli-*.tar

# Unreleased SDK staged by tools/stage-ci-sdk.sh and tools/build-sdk/build-sdk.sh
.ci-sdk/
.sdk-build/
